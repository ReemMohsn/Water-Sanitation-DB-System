@model Subscriber
@{
		ViewData["Titel"]="Subscriber Creating Page";
}
<div class="container p-3">
    <div class="row pt-4"> 
        <h2 class="text-primary-emphasis">Create New Subscriber</h2>
    </div>
    <div class="row pt-3"> 
        <form asp-action="Create" method="post">
              <div class="form-group">
                 <label class="text-primary-emphasis" asp-for="IdentificationNumber"></label>
                 <input asp-for="IdentificationNumber" class="form-control" />
                 <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
              </div>
              <div class="form-group">
                 <label class="text-primary-emphasis" asp-for="SubscriberName"></label>
                 <input asp-for="SubscriberName" class="form-control" />
                 <span asp-validation-for="SubscriberName" class="text-danger"></span>
              </div>
              <div class="form-group">
                 <label class="text-primary-emphasis" asp-for="SubscriberPhone"></label>
                 <input asp-for="SubscriberPhone" class="form-control" />
                 <span asp-validation-for="SubscriberPhone" class="text-danger"></span>
              </div>
              <button type="submit" class="btn btn-outline-primary mt-4">Create</button>
        </form>
    </div>    
</div>

