@model IEnumerable<waterSystemReem.Models.CounterListViewModel>
@{
    ViewData["Title"] = "Counters Page";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary-emphasis">The Counters</h2>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-outline-primary" asp-controller="Counter" asp-action="Create" style="margin:15px;">Create New Counter</a>
        </div>
    </div>

    <!-- Search Form -->
    <div class="row pt-4">
        <form method="get" asp-action="Show" class="input-group mb-3">
            <input type="text" name="searchString" class="form-control" placeholder="Search for Counters" value="@ViewBag.SearchString" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <button type="submit" class="btn btn-outline-secondary" asp-action="Show">Show All</button>
        </form>
    </div>

    <!-- Counters Table -->
    <div class="row pt-3">
        <table class="table table-hover">
            <thead>
                <tr class="table-secondary">
                    <th class="text-primary-emphasis" scope="col">Counter Number</th>
                    <th class="text-primary-emphasis" scope="col">Counter Location</th>
                    <th class="text-primary-emphasis" scope="col">Last Reading Date</th>
                    <th class="text-primary-emphasis" scope="col">Previous Balance</th>
                    <th class="text-primary-emphasis" scope="col">Counter Type</th>
                    <th class="text-primary-emphasis"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var counter in Model)
                {
                    <tr class="table-default">
                        <td class="text-primary">@counter.CounterNumber</td>
                        <td class="text-primary">@counter.CounterLocation</td>
                        <td class="text-primary">@counter.DateLastReading.ToShortDateString()</td>
                        <td class="text-primary">@counter.PreviseBalance.ToString("C")</td>
                        <td class="text-primary">@counter.CounterTypeName</td>
                        <td class="text-primary">
                            <a class="btn btn-outline-primary" asp-controller="Counter" asp-action="Details" asp-route-id="@counter.CounterId">Show Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>